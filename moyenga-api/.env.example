# --- Application ---
NODE_ENV=development
PORT=3000
API_PREFIX=api

# --- Base de données ---
# Doit correspondre au docker-compose.yml
DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5432/ecommerce_db?schema=public"

# --- Auth / JWT ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---
CORS_ORIGIN=http://localhost:4200

# --- Paiement (exemple) ---
PAYMENT_PROVIDER_KEY=

# --- Uploads ---
UPLOAD_DRIVER=local
UPLOAD_DEST=./uploads
